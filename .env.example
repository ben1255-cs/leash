# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app, enables signature verification on /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# AI provider: set ONE of these. Without any, the scripted demo agent runs and the AI reviewer is off.
# Google Gemini (free, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override, e.g. gemini-2.5-flash-lite
AI_MODEL=

# Currency for payouts and invoices (must match your sandbox business account)
CURRENCY=USD

# Optional: protect the public demo's buttons with a shared password
DEMO_PASSWORD=
