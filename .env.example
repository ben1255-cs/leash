# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app, enables signature verification on /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com). Without it, the scripted demo agent runs and the AI reviewer is off.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-5

# Currency for payouts and invoices (must match your sandbox business account)
CURRENCY=USD

# Optional: protect the public demo's buttons with a shared password
DEMO_PASSWORD=
